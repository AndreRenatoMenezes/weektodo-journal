{
  "name": "WeekToDo Journal — auth",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "weektodo/auth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://todo.bragademenezes.com"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook auth",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 0],
      "webhookId": "a1000000-0000-4000-8000-0000000000f1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT username\n  FROM sync_user\n WHERE username = $1\n   AND password_hash = crypt($2, password_hash)",
        "options": {
          "queryReplacement": "={{ $json.body.username }},{{ $json.body.password }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Verificar credencial",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [-100, 0],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "SUBSTITUA_PELO_ID_DA_CREDENCIAL",
          "name": "Postgres WeekToDo"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1000000-0000-4000-8000-0000000000c1",
              "leftValue": "={{ $json.username }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Credencial valida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "jsCode": "// Token aleatorio de 32 bytes. O banco guarda apenas o SHA-256: vazamento\n// da tabela nao expoe token utilizavel.\nconst crypto = require('crypto');\nconst token = crypto.randomBytes(32).toString('hex');\nconst tokenHash = crypto.createHash('sha256').update(token).digest('hex');\nreturn [{ json: { token, tokenHash, username: $json.username } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Gerar token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, -100]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sync_token (token_hash, username)\nVALUES ($1, $2)\nRETURNING token_hash",
        "options": {
          "queryReplacement": "={{ $json.tokenHash }},{{ $json.username }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Gravar token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [560, -100],
      "credentials": {
        "postgres": {
          "id": "SUBSTITUA_PELO_ID_DA_CREDENCIAL",
          "name": "Postgres WeekToDo"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ token: $('Gerar token').item.json.token, username: $('Gerar token').item.json.username }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'unauthorized' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [340, 120]
    }
  ],
  "connections": {
    "Webhook auth": {
      "main": [[{ "node": "Verificar credencial", "type": "main", "index": 0 }]]
    },
    "Verificar credencial": {
      "main": [[{ "node": "Credencial valida?", "type": "main", "index": 0 }]]
    },
    "Credencial valida?": {
      "main": [
        [{ "node": "Gerar token", "type": "main", "index": 0 }],
        [{ "node": "Responder 401", "type": "main", "index": 0 }]
      ]
    },
    "Gerar token": {
      "main": [[{ "node": "Gravar token", "type": "main", "index": 0 }]]
    },
    "Gravar token": {
      "main": [[{ "node": "Responder 200", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
