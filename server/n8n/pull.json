{
  "name": "WeekToDo Journal — pull",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "weektodo/pull",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://todo.bragademenezes.com"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Webhook pull",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 0],
      "webhookId": "b1000000-0000-4000-8000-0000000000f1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- O cliente manda o token em claro no header; o banco compara o SHA-256.\nUPDATE sync_token\n   SET usado_em = now()\n WHERE token_hash = encode(digest($1, 'sha256'), 'hex')\nRETURNING username",
        "options": {
          "queryReplacement": "={{ ($json.headers.authorization || '').split(' ')[1] || '' }}"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Autenticar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [-100, 0],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "SUBSTITUA_PELO_ID_DA_CREDENCIAL",
          "name": "Postgres WeekToDo"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b1000000-0000-4000-8000-0000000000c1",
              "leftValue": "={{ $json.username }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Token valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT COALESCE(MAX(revision), 0) FROM sync_doc) AS revision,\n       COALESCE(\n         (SELECT json_agg(d ORDER BY d.revision)\n            FROM (SELECT kind,\n                         doc_id AS \"docId\",\n                         payload,\n                         revision,\n                         deleted\n                    FROM sync_doc\n                   WHERE revision > $1::bigint) d),\n         '[]'::json\n       ) AS docs",
        "options": {
          "queryReplacement": "={{ Number($('Webhook pull').item.json.body.since) || 0 }}"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Buscar documentos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [340, -100],
      "credentials": {
        "postgres": {
          "id": "SUBSTITUA_PELO_ID_DA_CREDENCIAL",
          "name": "Postgres WeekToDo"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ revision: $json.revision, docs: $json.docs }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [560, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'unauthorized' }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Responder 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [340, 120]
    }
  ],
  "connections": {
    "Webhook pull": {
      "main": [[{ "node": "Autenticar", "type": "main", "index": 0 }]]
    },
    "Autenticar": {
      "main": [[{ "node": "Token valido?", "type": "main", "index": 0 }]]
    },
    "Token valido?": {
      "main": [
        [{ "node": "Buscar documentos", "type": "main", "index": 0 }],
        [{ "node": "Responder 401", "type": "main", "index": 0 }]
      ]
    },
    "Buscar documentos": {
      "main": [[{ "node": "Responder 200", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
